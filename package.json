{
  "name": "pxg-file-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "dev.pxg.workbench",
    "productName": "PXG File Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "server/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.2",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.5"
  }
}
